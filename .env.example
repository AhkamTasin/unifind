# Copy this file to .env (or export these variables) to use MySQL.
# By default the app runs on SQLite — no configuration needed.

# Set to "mysql" to use MySQL, "sqlite" (default) otherwise
DB_ENGINE=mysql

# MySQL connection details
DB_NAME=campus_lost_found
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_HOST=127.0.0.1
DB_PORT=3306

# Django (optional)
# DJANGO_SECRET_KEY=change-me
# DJANGO_DEBUG=1
# DJANGO_ALLOWED_HOSTS=*
